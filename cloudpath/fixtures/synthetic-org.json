      "kind": "principal"
    },
    {
      "id": "role:build",
      "kind": "role"
    },
    {
      "id": "role:release",
      "kind": "role"
    },
    {
      "id": "role:admin",
      "kind": "role"
    },
    {
      "id": "resource:synthetic-secret",
      "kind": "resource"
    },
    {
      "id": "principal:intern",
