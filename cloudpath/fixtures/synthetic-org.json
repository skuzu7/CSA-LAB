      "to": "resource:public-docs",
      "action": "s3:GetObject",
      "revocable": true
    },
    {
      "from": "principal:intern",
      "to": "role:admin",
      "action": "sts:AssumeRole",
      "condition_met": false
    }
  ],
  "queries": [
    {
      "source": "principal:developer",
      "target": "resource:synthetic-secret",
      "expected_reachable": true
    },
    {
      "source": "principal:intern",
      "target": "resource:synthetic-secret",
